{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://novaos/theme.schema.json",
  "title": "NovaOS Theme Package",
  "description": "Formato .novatheme (1 o 2) — pacchetto tema/interfaccia per NovaOS. La versione 2 aggiunge il campo 'layout' (launcher della home).",
  "type": "object",
  "required": ["format", "meta", "colors"],
  "additionalProperties": false,
  "properties": {
    "format": { "enum": ["novatheme/1", "novatheme/2"] },
    "layout": {
      "type": "object",
      "description": "novatheme/2 — paradigma della home (launcher provider). Le app non cambiano.",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id":     { "type": "string", "description": "id del launcher: springboard | list | drawer | tiles | dash | radial | cover | …" },
        "params": { "type": "object", "description": "parametri specifici del launcher" }
      }
    },
    "meta": {
      "type": "object",
      "required": ["id", "name", "base"],
      "additionalProperties": false,
      "properties": {
        "id":      { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name":    { "type": "string", "minLength": 1 },
        "author":  { "type": "string" },
        "version": { "type": "string" },
        "base":    { "enum": ["dark", "light"] }
      }
    },
    "colors": {
      "type": "object",
      "description": "Mappano 1:1 le variabili CSS di NovaOS.",
      "additionalProperties": false,
      "properties": {
        "bg":        { "$ref": "#/$defs/color" },
        "bg-2":      { "$ref": "#/$defs/color" },
        "surface":   { "$ref": "#/$defs/color" },
        "surface-2": { "$ref": "#/$defs/color" },
        "text":      { "$ref": "#/$defs/color" },
        "text-dim":  { "$ref": "#/$defs/color" },
        "accent":    { "$ref": "#/$defs/color" },
        "accent-2":  { "$ref": "#/$defs/color" },
        "danger":    { "$ref": "#/$defs/color" },
        "ok":        { "$ref": "#/$defs/color" }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "radius":    { "type": "number", "minimum": 0, "maximum": 48 },
        "radiusSm":  { "type": "number", "minimum": 0, "maximum": 32 },
        "iconStyle": { "enum": ["filled", "outline"] }
      }
    },
    "wallpaper": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type":  { "enum": ["gradient", "image", "solid"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "icons": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pack":  { "type": "string" },
        "shape": { "enum": ["circle", "squircle", "square"] },
        "map": {
          "type": "object",
          "description": "id app NovaOS -> icona.",
          "additionalProperties": { "$ref": "#/$defs/icon" }
        }
      }
    },
    "sounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ringtone": { "$ref": "#/$defs/sound" },
        "notif":    { "$ref": "#/$defs/sound" },
        "alarm":    { "$ref": "#/$defs/sound" }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "textScale": { "type": "number", "minimum": 80, "maximum": 140 },
        "font": { "enum": ["system", "serif", "mono"] },
        "weight": { "enum": ["normal", "medium", "bold"] }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "icon": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type":  { "enum": ["emoji", "svg", "image"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "sound": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["builtin", "sequence"] },
        "value": {
          "oneOf": [
            { "type": "string", "description": "nome di un suono integrato" },
            {
              "type": "array",
              "description": "sequenza di note [frequenzaHz, durataSec]; freq 0 = pausa",
              "items": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2
              }
            }
          ]
        }
      }
    }
  }
}
