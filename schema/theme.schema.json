{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://novaos/theme.schema.json",
  "title": "NovaOS Theme Package",
  "description": "Formato .novatheme (1 o 2) — pacchetto tema/interfaccia per NovaOS. La versione 2 aggiunge il campo 'layout' (launcher della home, anche a blocchi).",
  "type": "object",
  "required": ["format", "meta", "colors"],
  "additionalProperties": false,
  "properties": {
    "format": { "enum": ["novatheme/1", "novatheme/2"] },
    "layout": {
      "type": "object",
      "description": "novatheme/2 — paradigma della home. Due forme: launcher predefinito ({id, params, order}) oppure layout a blocchi ({engine:'blocks', name, blocks}). Le app non cambiano.",
      "additionalProperties": false,
      "properties": {
        "id":     { "type": "string", "description": "id del launcher: springboard | list | drawer | tiles | dash | radial | cover | index" },
        "params": { "type": "object", "description": "parametri specifici del launcher" },
        "order":  { "type": "array", "description": "ordine personalizzato delle app (id)", "items": { "type": "string" } },
        "engine": { "enum": ["blocks"], "description": "motore generico a blocchi (launcher «Personalizzato»)" },
        "name":   { "type": "string", "description": "nome mostrato per il layout a blocchi" },
        "blocks": { "type": "array", "description": "blocchi della home (engine='blocks')", "minItems": 1, "items": { "$ref": "#/$defs/block" } }
      },
      "allOf": [
        {
          "if": { "properties": { "engine": { "const": "blocks" } }, "required": ["engine"] },
          "then": { "required": ["blocks"] },
          "else": { "required": ["id"] }
        }
      ]
    },
    "meta": {
      "type": "object",
      "required": ["id", "name", "base"],
      "additionalProperties": false,
      "properties": {
        "id":      { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name":    { "type": "string", "minLength": 1 },
        "author":  { "type": "string" },
        "version": { "type": "string" },
        "base":    { "enum": ["dark", "light"] }
      }
    },
    "colors": {
      "type": "object",
      "description": "Mappano 1:1 le variabili CSS di NovaOS.",
      "additionalProperties": false,
      "properties": {
        "bg":        { "$ref": "#/$defs/color" },
        "bg-2":      { "$ref": "#/$defs/color" },
        "surface":   { "$ref": "#/$defs/color" },
        "surface-2": { "$ref": "#/$defs/color" },
        "text":      { "$ref": "#/$defs/color" },
        "text-dim":  { "$ref": "#/$defs/color" },
        "accent":    { "$ref": "#/$defs/color" },
        "accent-2":  { "$ref": "#/$defs/color" },
        "danger":    { "$ref": "#/$defs/color" },
        "ok":        { "$ref": "#/$defs/color" },
        "icon":      { "$ref": "#/$defs/color", "description": "colore delle icone monocromatiche" }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "radius":    { "type": "number", "minimum": 0, "maximum": 48 },
        "radiusSm":  { "type": "number", "minimum": 0, "maximum": 32 },
        "iconStyle": { "enum": ["filled", "outline"] },
        "iconShape": { "enum": ["circle", "squircle", "square"], "description": "forma della tessera icona" }
      }
    },
    "wallpaper": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type":  { "enum": ["gradient", "image", "solid"] },
        "value": { "type": "string", "minLength": 1 },
        "fit":   { "enum": ["cover", "contain", "custom"], "description": "inquadratura (solo type=image)" },
        "zoom":  { "type": "number", "minimum": 60, "maximum": 260, "description": "zoom percentuale (solo fit=custom)" },
        "posX":  { "type": "number", "minimum": 0, "maximum": 100, "description": "posizione orizzontale percentuale (solo type=image)" },
        "posY":  { "type": "number", "minimum": 0, "maximum": 100, "description": "posizione verticale percentuale (solo type=image)" }
      }
    },
    "icons": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pack":  { "type": "string" },
        "shape": { "enum": ["circle", "squircle", "square"] },
        "map": {
          "type": "object",
          "description": "id app NovaOS -> icona.",
          "additionalProperties": { "$ref": "#/$defs/icon" }
        }
      }
    },
    "sounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ringtone": { "$ref": "#/$defs/sound" },
        "notif":    { "$ref": "#/$defs/sound" },
        "alarm":    { "$ref": "#/$defs/sound" }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "textScale": { "type": "number", "minimum": 80, "maximum": 130 },
        "font": { "enum": ["system", "serif", "mono"] },
        "weight": { "enum": ["normal", "medium", "bold"] }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "block": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type":   { "type": "string", "description": "clock | weather | bubbles | dock | appgrid | appindex | …" },
        "params": { "type": "object" }
      }
    },
    "icon": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type":  { "enum": ["emoji", "svg", "image"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "sound": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["builtin", "sequence"] },
        "value": {
          "oneOf": [
            { "type": "string", "description": "nome di un suono integrato" },
            {
              "type": "array",
              "description": "sequenza di note [frequenzaHz, durataSec]; freq 0 = pausa",
              "items": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2
              }
            }
          ]
        }
      }
    }
  }
}
